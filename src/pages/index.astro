---
import EditionPage from "../components/EditionPage.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
import { getCurrentEdition, getEditionBundle } from "../lib/content"
import { localizeEditionBundle } from "../lib/i18n"

const current = await getCurrentEdition()
const bundle = localizeEditionBundle(await getEditionBundle(current.data.version), "en-AU")
const title = "Lymphoedema Research Brief — Evidence snapshot"
const description = `Plain-language summaries of recent lymphoedema research, limitations, and studies in progress. Edition ${current.data.version}, reviewed ${current.data.reviewedOn}.`
---

<BaseLayout title={title} description={description} alternatePaths={{ enAU: "/", zhCN: "/zh-cn/" }}>
  <EditionPage {...bundle} />
</BaseLayout>
