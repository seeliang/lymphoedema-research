---
import EditionPage from "../../../../components/EditionPage.astro"
import BaseLayout from "../../../../layouts/BaseLayout.astro"
import { getAllEditions, getEditionBundle } from "../../../../lib/content"
import { hasZhCNTranslation, localizeEditionBundle, type LocalizedEditionBundle } from "../../../../lib/i18n"

export async function getStaticPaths() {
  const editions = (await getAllEditions()).filter((edition) => hasZhCNTranslation(edition.data.version))
  return Promise.all(editions.map(async (edition) => ({
    params: { version: edition.data.version },
    props: { bundle: localizeEditionBundle(await getEditionBundle(edition.data.version), "zh-CN") },
  })))
}

interface Props { bundle: LocalizedEditionBundle }
const { bundle } = Astro.props
const title = bundle.edition.data.evidenceOverview
  ? `第 ${bundle.edition.data.version} 版｜${bundle.edition.data.title}`
  : `第 ${bundle.edition.data.version} 版｜淋巴水肿研究简报`
const description = bundle.edition.data.evidenceOverview
  ? bundle.edition.data.summary
  : `全球英文第 ${bundle.edition.data.version} 版的简体中文稿，包含研究局限和试验状态。`
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/zh-cn/versions/${bundle.edition.data.version}/`}
  lang="zh-CN"
  noindex
  alternatePaths={{
    enAU: `/versions/${bundle.edition.data.version}/`,
    zhCN: `/zh-cn/versions/${bundle.edition.data.version}/`,
  }}
>
  <EditionPage {...bundle} archive />
</BaseLayout>
