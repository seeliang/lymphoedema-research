---
import BrandMark from "../../../components/BrandMark.astro"
import BaseLayout from "../../../layouts/BaseLayout.astro"
import { getAllEditions } from "../../../lib/content"
import { getZhCNTranslation, hasZhCNTranslation } from "../../../lib/i18n"
import { withBase } from "../../../lib/paths"

const editions = (await getAllEditions()).filter((edition) => hasZhCNTranslation(edition.data.version))
const formatDate = (date: string) => new Intl.DateTimeFormat("zh-CN", {
  day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
}).format(new Date(`${date}T00:00:00Z`))
const statusLabels = { draft: "草稿", current: "最新一期", superseded: "已有更新", withdrawn: "已撤回" }
---

<BaseLayout
  title="历史版本｜淋巴水肿研究简报"
  description="查看淋巴水肿研究简报的中文历史版本、翻译修订和更正记录。"
  canonicalPath="/zh-cn/versions/"
  lang="zh-CN"
  noindex
  alternatePaths={{ enAU: "/versions/", zhCN: "/zh-cn/versions/" }}
>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href={withBase("/zh-cn/")}>
        <BrandMark />
        <span><strong>淋巴水肿研究简报</strong><small>为患者和照护者整理的研究摘要</small></span>
      </a>
      <div class="header-actions">
        <nav aria-label="主导航"><a href={withBase("/zh-cn/")}>最新一期</a></nav>
        <a class="language-switch" href={withBase("/versions/")} lang="en-AU" hreflang="en-AU" aria-label="查看全球英文版的历史记录">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h10M9 3v2c0 4-2 7-5 9m3-5c1.5 2.5 3.5 4.4 6 5.6M15 10l4 11m2 0-4-11m-.8 7h3.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          English
        </a>
      </div>
    </div>
  </header>
  <main id="main-content" class="versions-page">
    <section class="versions-hero">
      <div class="shell narrow-shell">
        <p class="eyebrow">版本与修订记录</p>
        <h1>每份中文稿都对应同一份全球英文版</h1>
        <p class="lede">中英文使用相同的研究版本号，研究选择、局限和来源链接保持一致。中文翻译的修订和审校状态另行记录。</p>
      </div>
    </section>
    <section class="section">
      <div class="shell narrow-shell edition-history">
        {editions.map((edition) => {
          const translation = getZhCNTranslation(edition.data.version)
          return (
            <article class="edition-row">
              <div>
                <span class:list={["edition-status", `edition-status--${edition.data.status}`]}>{statusLabels[edition.data.status]}</span>
                <h2>第 {edition.data.version} 版</h2>
                <p>英文资料核对于 {formatDate(edition.data.reviewedOn)} · 内容格式版本 {edition.data.schemaVersion}</p>
                <p class="translation-state">中文稿更新于 {formatDate(translation.translatedOn)} · 修订 {translation.translationRevision} · {translation.translationStatus === "human-reviewed" ? "已完成独立人工语言审校" : "AI 辅助译稿，未经独立人工语言审校"}</p>
              </div>
              <ul>{translation.changes.map((change) => <li>{change}</li>)}</ul>
              <div class="edition-actions">
                <a class="button button--primary" href={withBase(`/zh-cn/versions/${edition.data.version}/`)}>查看本期中文稿</a>
                <a class="text-link" href={withBase(`/zh-cn/versions/${edition.data.version}/edition.json`)}>查看中文 JSON</a>
              </div>
            </article>
          )
        })}
      </div>
    </section>
  </main>
  <footer><div class="shell footer-grid"><p>淋巴水肿研究简报 · 独立公益项目</p></div></footer>
</BaseLayout>
