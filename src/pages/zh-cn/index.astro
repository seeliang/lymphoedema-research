---
import EditionPage from "../../components/EditionPage.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getCurrentEdition, getEditionBundle } from "../../lib/content"
import { localizeEditionBundle } from "../../lib/i18n"

const current = await getCurrentEdition()
const bundle = localizeEditionBundle(await getEditionBundle(current.data.version), "zh-CN")
const title = "淋巴水肿研究简报｜简体中文"
const description = `为患者和照护者整理的全球淋巴水肿研究摘要，包含重要局限和仍在进行的试验。第 ${current.data.version} 版。`
const needsHumanTranslationReview = bundle.translation?.status !== "human-reviewed"
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/zh-cn/"
  lang="zh-CN"
  noindex={needsHumanTranslationReview}
  alternatePaths={{ enAU: "/", zhCN: "/zh-cn/" }}
>
  <EditionPage {...bundle} />
</BaseLayout>
