---
import EditionPage from "../../../components/EditionPage.astro"
import BaseLayout from "../../../layouts/BaseLayout.astro"
import { getAllEditions, getEditionBundle } from "../../../lib/content"
import { hasZhCNTranslation, localizeEditionBundle, type LocalizedEditionBundle } from "../../../lib/i18n"

export async function getStaticPaths() {
  const editions = await getAllEditions()
  return Promise.all(editions.map(async (edition) => ({
    params: { version: edition.data.version },
    props: { bundle: localizeEditionBundle(await getEditionBundle(edition.data.version), "en-AU") },
  })))
}

interface Props { bundle: LocalizedEditionBundle }
const { bundle } = Astro.props
const title = `Edition ${bundle.edition.data.version} — Lymphoedema Research Brief`
const description = `Permanent evidence snapshot reviewed ${bundle.edition.data.reviewedOn}. Source-reviewed summaries with limitations and trial status.`
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/versions/${bundle.edition.data.version}/`}
  noindex
  alternatePaths={hasZhCNTranslation(bundle.edition.data.version) ? {
    enAU: `/versions/${bundle.edition.data.version}/`,
    zhCN: `/zh-cn/versions/${bundle.edition.data.version}/`,
  } : undefined}
>
  <EditionPage {...bundle} archive />
</BaseLayout>
