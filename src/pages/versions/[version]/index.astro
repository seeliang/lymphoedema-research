---
import EditionPage from "../../../components/EditionPage.astro"
import BaseLayout from "../../../layouts/BaseLayout.astro"
import { getAllEditions, getEditionBundle, type EditionBundle } from "../../../lib/content"

export async function getStaticPaths() {
  const editions = await getAllEditions()
  return Promise.all(editions.map(async (edition) => ({
    params: { version: edition.data.version },
    props: { bundle: await getEditionBundle(edition.data.version) },
  })))
}

interface Props { bundle: EditionBundle }
const { bundle } = Astro.props
const title = `Edition ${bundle.edition.data.version} — Lymphoedema Research Brief`
const description = `Permanent evidence snapshot reviewed ${bundle.edition.data.reviewedOn}. Source-reviewed summaries with limitations and trial status.`
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/versions/${bundle.edition.data.version}/`}
  noindex
>
  <EditionPage {...bundle} archive />
</BaseLayout>
