---
import BrandMark from "../../components/BrandMark.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getAllEditions } from "../../lib/content"
import { withBase } from "../../lib/paths"

const editions = await getAllEditions()
const formatDate = (date: string) => new Intl.DateTimeFormat("en-AU", {
  day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
}).format(new Date(`${date}T00:00:00Z`))
---

<BaseLayout
  title="Version history — Lymphoedema Research Brief"
  description="Browse dated, permanent editions and correction history for the Lymphoedema Research Brief."
  canonicalPath="/versions/"
>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href={withBase("/")}>
        <BrandMark />
        <span><strong>Lymphoedema Research Brief</strong><small>Source-reviewed evidence snapshots</small></span>
      </a>
      <nav aria-label="Primary navigation"><a href={withBase("/")}>Latest edition</a></nav>
    </div>
  </header>
  <main id="main-content" class="versions-page">
    <section class="versions-hero">
      <div class="shell narrow-shell">
        <p class="eyebrow">Public history</p>
        <h1>Every reviewed edition stays visible</h1>
        <p class="lede">Monthly snapshots use calendar versioning. Corrections create a patch edition and attach a notice to the original rather than rewriting history.</p>
      </div>
    </section>
    <section class="section">
      <div class="shell narrow-shell edition-history">
        {editions.map((edition) => (
          <article class="edition-row">
            <div>
              <span class:list={["edition-status", `edition-status--${edition.data.status}`]}>{edition.data.status}</span>
              <h2>Edition {edition.data.version}</h2>
              <p>Reviewed {formatDate(edition.data.reviewedOn)} · Schema {edition.data.schemaVersion}</p>
            </div>
            <ul>{edition.data.changes.map((change) => <li>{change}</li>)}</ul>
            <div class="edition-actions">
              <a class="button button--primary" href={withBase(`/versions/${edition.data.version}/`)}>Open snapshot</a>
              <a class="text-link" href={withBase(`/versions/${edition.data.version}/edition.json`)}>Edition JSON</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <footer><div class="shell footer-grid"><p>Lymphoedema Research Brief · A Crosspathing Studio public-interest project</p></div></footer>
</BaseLayout>
