---
import { withBase } from "../lib/paths"
import { enAUUI, zhCNUI } from "../i18n/ui"
import type { SiteLocale } from "../lib/i18n"
import "../styles/global.css"

interface Props {
  title: string
  description: string
  canonicalPath?: string
  noindex?: boolean
  lang?: SiteLocale
  alternatePaths?: { enAU: string; zhCN: string }
}

const {
  title,
  description,
  canonicalPath = "/",
  noindex = false,
  lang = "en-AU",
  alternatePaths,
} = Astro.props
const canonicalUrl = new URL(withBase(canonicalPath), Astro.site)
const copy = lang === "zh-CN" ? zhCNUI : enAUUI
const ogLocale = lang === "zh-CN" ? "zh_CN" : "en_AU"
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {alternatePaths && (
      <>
        <link rel="alternate" hreflang="en-AU" href={new URL(withBase(alternatePaths.enAU), Astro.site)} />
        <link rel="alternate" hreflang="zh-CN" href={new URL(withBase(alternatePaths.zhCN), Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(withBase(alternatePaths.enAU), Astro.site)} />
      </>
    )}
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={copy.siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skipLink}</a>
    <slot />
  </body>
</html>
