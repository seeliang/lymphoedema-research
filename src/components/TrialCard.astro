---
import { enAUUI, zhCNUI } from "../i18n/ui"
import type { LocalizedEditionBundle, SiteLocale } from "../lib/i18n"
import ExternalLinkIcon from "./ExternalLinkIcon.astro"

interface Props {
  trial: LocalizedEditionBundle["edition"]["data"]["trials"][number]
  locale: SiteLocale
}

const { trial, locale } = Astro.props
const copy = locale === "zh-CN" ? zhCNUI : enAUUI
const formatDate = (date: string) => new Intl.DateTimeFormat(locale, {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${date}T00:00:00Z`))
---

<article class="trial-card trial-card--sectioned">
  <header class="sectioned-trial-header">
    <div>
      <div class="trial-status"><span aria-hidden="true"></span>{copy.trials.status(trial.status)}</div>
      <p class="trial-id">{trial.nctId}</p>
    </div>
    <h3>{trial.title}</h3>
  </header>
  <div class="sectioned-trial-body">
    <dl class="sectioned-trial-facts">
      <div class="sectioned-trial-fact--wide"><dt>{copy.trials.population}</dt><dd>{trial.population}</dd></div>
      <div class="sectioned-trial-fact--wide"><dt>{copy.trials.design}</dt><dd>{trial.design}</dd></div>
      <div><dt>{copy.trials.enrolment}</dt><dd>{trial.enrolment}</dd></div>
      <div><dt>{copy.trials.checked}</dt><dd>{formatDate(trial.checkedOn)}</dd></div>
    </dl>
    <aside class="sectioned-trial-caution">
      <strong>{copy.trials.caution}</strong>
      <p>{trial.caution}</p>
      <a class="text-link" href={trial.url}>{copy.trials.registry} <ExternalLinkIcon /></a>
    </aside>
  </div>
</article>
