---
import { enAUUI, zhCNUI } from "../i18n/ui"
import { hasZhCNTranslation, type LocalizedEditionBundle } from "../lib/i18n"
import { withBase } from "../lib/paths"
import BrandMark from "./BrandMark.astro"
import ExternalLinkIcon from "./ExternalLinkIcon.astro"

interface Props extends LocalizedEditionBundle {
  archive?: boolean
}

const { edition, evidence, notices, locale, translation, archive = false } = Astro.props
const { data } = edition
const isCurrent = data.status === "current"
const isChinese = locale === "zh-CN"
const copy = isChinese ? zhCNUI : enAUUI
const formatDate = (date: string) => new Intl.DateTimeFormat(locale, {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${date}T00:00:00Z`))
const pagePath = archive ? `/versions/${data.version}/` : "/"
const languageSwitchPath = isChinese ? pagePath : `/zh-cn${pagePath}`
const latestPath = isChinese ? "/zh-cn/" : "/"
const versionsPath = isChinese ? "/zh-cn/versions/" : "/versions/"
const translationAvailable = hasZhCNTranslation(data.version)
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBase(latestPath)} aria-label={`${copy.siteName} ${copy.navigation.latest}`}>
      <BrandMark />
      <span>
        <strong>{copy.siteName}</strong>
        <small>{copy.tagline}</small>
      </span>
    </a>
    <div class="header-actions">
      <nav aria-label={copy.navigation.label}>
        <a href={archive ? withBase(`${isChinese ? "/zh-cn" : ""}/versions/${data.version}/#evidence`) : "#evidence"}>{copy.navigation.evidence}</a>
        <a href={archive ? withBase(`${isChinese ? "/zh-cn" : ""}/versions/${data.version}/#trials`) : "#trials"}>{copy.navigation.trials}</a>
        <a href={withBase(versionsPath)}>{copy.navigation.versions}</a>
      </nav>
      {(isChinese || translationAvailable) && (
        <a class="language-switch" href={withBase(languageSwitchPath)} lang={isChinese ? "en-AU" : "zh-CN"} hreflang={isChinese ? "en-AU" : "zh-CN"} aria-label={copy.languageSwitch.label}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h10M9 3v2c0 4-2 7-5 9m3-5c1.5 2.5 3.5 4.4 6 5.6M15 10l4 11m2 0-4-11m-.8 7h3.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          {copy.languageSwitch.text}
        </a>
      )}
    </div>
  </div>
</header>

{archive && (
  <aside class:list={["archive-banner", !isCurrent && "archive-banner--superseded"]} aria-label={copy.archive.label}>
    <div class="shell archive-banner-inner">
      <strong>{isCurrent ? copy.archive.currentTitle : copy.archive.supersededTitle}</strong>
      <span>
        {isCurrent
          ? copy.archive.currentBody(data.version)
          : copy.archive.supersededBody(data.version)}
      </span>
      <a href={withBase(latestPath)}>{copy.archive.latestLink}</a>
    </div>
  </aside>
)}

{notices.map((notice) => (
  <aside class="notice-banner" aria-label={copy.notice.label(notice.data.type)}>
    <div class="shell">
      <strong>{copy.notice.title(notice.data.type)}</strong>
      <p>{notice.data.message}</p>
      {notice.data.replacementVersion && (
        <a href={withBase(`${isChinese ? "/zh-cn" : ""}/versions/${notice.data.replacementVersion}/`)}>
          {copy.notice.replacement(notice.data.replacementVersion)}
        </a>
      )}
    </div>
  </aside>
))}

<main id="main-content">
  <section class="hero">
    <div class="hero-pattern" aria-hidden="true">
      <svg viewBox="0 0 800 420" preserveAspectRatio="xMidYMid slice">
        <g fill="none" stroke="currentColor" stroke-width="2">
          <path d="M-40 330C120 310 135 120 310 158s210 216 520 50"></path>
          <path d="M80 20c40 110 160 75 205 180s180 85 240 210"></path>
        </g>
        <g fill="currentColor">
          <circle cx="140" cy="282" r="8"></circle>
          <circle cx="310" cy="158" r="10"></circle>
          <circle cx="515" cy="280" r="7"></circle>
          <circle cx="690" cy="238" r="11"></circle>
        </g>
      </svg>
    </div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{copy.hero.eyebrow(data.version, formatDate(data.reviewedOn))}</p>
        <h1>{copy.hero.title}</h1>
        <p class="lede">{data.summary}</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#evidence">{copy.hero.evidenceButton}</a>
          <a class="button button--secondary" href={withBase(`${isChinese ? "/zh-cn" : ""}/versions/${data.version}/`)}>{copy.hero.permanentLink}</a>
        </div>
      </div>
      <aside class="review-card" aria-labelledby="review-card-title">
        <div class="review-card-heading">
          <span class="status-dot" aria-hidden="true"></span>
          <h2 id="review-card-title">{copy.review.title}</h2>
        </div>
        <dl>
          <div><dt>{copy.review.reviewed}</dt><dd>{formatDate(data.reviewedOn)}</dd></div>
          <div><dt>{copy.review.nextDue}</dt><dd>{formatDate(data.nextReviewDue)}</dd></div>
          <div><dt>{copy.review.itemCount}</dt><dd>{evidence.length}</dd></div>
          <div><dt>{copy.review.editorialStatus}</dt><dd>{copy.review.editorialValue}</dd></div>
          {translation && <div><dt>{copy.review.translationUpdated}</dt><dd>{formatDate(translation.translatedOn)}</dd></div>}
          {translation && <div><dt>{copy.review.translationStatus}</dt><dd>{copy.review.translationValue(translation.revision, translation.status)}</dd></div>}
        </dl>
      </aside>
    </div>
  </section>

  <section class="disclaimer" aria-labelledby="disclaimer-title">
    <div class="shell disclaimer-inner">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2.5 20h19L12 3Zm0 6v5m0 3h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <div>
        <h2 id="disclaimer-title">{copy.disclaimer.title}</h2>
        <p>{copy.disclaimer.body}</p>
      </div>
    </div>
  </section>

  {copy.translationNotice && (
    <section class="translation-notice" aria-labelledby="translation-note-title">
      <div class="shell translation-notice-inner">
        <div>
          <h2 id="translation-note-title">{copy.translationNotice.title}</h2>
          <p>{copy.translationNotice.body}</p>
        </div>
        <a class="button button--secondary" href={withBase(pagePath)} hreflang="en-AU">{copy.translationNotice.link}</a>
      </div>
    </section>
  )}

  <section class="section section--takeaways" aria-labelledby="takeaways-title">
    <div class="shell">
      <p class="eyebrow">{copy.takeaways.eyebrow}</p>
      <h2 id="takeaways-title">{copy.takeaways.title}</h2>
      <div class="takeaway-grid">
        {copy.takeaways.items.map(([title, body], index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="evidence" class="section" aria-labelledby="evidence-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{copy.evidence.eyebrow}</p>
          <h2 id="evidence-title">{copy.evidence.title}</h2>
        </div>
        <p>{copy.evidence.intro}</p>
      </div>

      <div class="evidence-list">
        {evidence.map((entry) => (
          <article class="evidence-card">
            <div class="evidence-card-topline">
              <span class="evidence-number">{String(entry.data.order).padStart(2, "0")}</span>
              <div class="badge-row">
                <span class="badge">{entry.data.area}</span>
                <span class="badge badge--level">{entry.data.evidenceLevel}</span>
              </div>
            </div>
            <h3>{entry.data.title}</h3>
            <dl class="study-context">
              <div><dt>{copy.evidence.population}</dt><dd>{entry.data.population}</dd></div>
              <div><dt>{copy.evidence.design}</dt><dd>{entry.data.studyDesign}</dd></div>
            </dl>
            <div class="finding-grid">
              <div>
                <h4>{copy.evidence.finding}</h4>
                <p>{entry.data.takeaway}</p>
              </div>
              <div>
                <h4>{copy.evidence.meaning}</h4>
                <p>{entry.data.meaning}</p>
              </div>
            </div>
            <aside class="limitation">
              <strong>{copy.evidence.limitation}</strong>
              <p>{entry.data.limitation}</p>
            </aside>
            <div class="sources" aria-label={copy.evidence.sources(entry.data.sources.length)}>
              <strong>{copy.evidence.sources(entry.data.sources.length)}</strong>
              <ul>
                {entry.data.sources.map((source) => (
                  <li>
                    <a href={source.url}>
                      {source.label}
                      <ExternalLinkIcon />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="trials" class="section section--tint" aria-labelledby="trials-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{copy.trials.eyebrow}</p>
          <h2 id="trials-title">{copy.trials.title}</h2>
        </div>
        <p>{copy.trials.intro}</p>
      </div>
      <div class="trial-grid">
        {data.trials.map((trial) => (
          <article class="trial-card">
            <div class="trial-status"><span aria-hidden="true"></span>{copy.trials.status(trial.status)}</div>
            <p class="trial-id">{trial.nctId}</p>
            <h3>{trial.title}</h3>
            <dl>
              <div><dt>{copy.trials.population}</dt><dd>{trial.population}</dd></div>
              <div><dt>{copy.trials.design}</dt><dd>{trial.design}</dd></div>
              <div><dt>{copy.trials.enrolment}</dt><dd>{trial.enrolment}</dd></div>
              <div><dt>{copy.trials.checked}</dt><dd>{formatDate(trial.checkedOn)}</dd></div>
            </dl>
            <p class="trial-caution"><strong>{copy.trials.caution}</strong> {trial.caution}</p>
            <a class="text-link" href={trial.url}>{copy.trials.registry} <ExternalLinkIcon /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="guide-title">
    <div class="shell guide-grid">
      <div>
        <p class="eyebrow">{copy.guide.eyebrow}</p>
        <h2 id="guide-title">{copy.guide.title}</h2>
        <p class="section-intro">{copy.guide.intro}</p>
      </div>
      <dl class="evidence-guide">
        {copy.guide.items.map(([term, description]) => (
          <div><dt>{term}</dt><dd>{description}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--care" aria-labelledby="care-title">
    <div class="shell care-grid">
      <div>
        <p class="eyebrow">{copy.care.eyebrow}</p>
        <h2 id="care-title">{copy.care.title}</h2>
        <p>{copy.care.body}</p>
        <div class="resource-links">
          <a class="button button--light" href="https://www.healthdirect.gov.au/lymphoedema">{copy.care.healthdirect} <ExternalLinkIcon /></a>
          <a class="button button--outline-light" href="https://www.lymphoedema.org.au/accreditation-nlpr/find-a-practitioner/">{copy.care.practitioner} <ExternalLinkIcon /></a>
        </div>
      </div>
      <aside class="urgent-card">
        <h3>{copy.care.urgentTitle}</h3>
        <p>{copy.care.urgentBody}</p>
        <a href="https://www.healthdirect.gov.au/lymphoedema">{copy.care.urgentLink} <ExternalLinkIcon /></a>
      </aside>
    </div>
  </section>

  <section class="section section--method" aria-labelledby="method-title">
    <div class="shell method-grid">
      <div>
        <p class="eyebrow">{copy.method.eyebrow}</p>
        <h2 id="method-title">{copy.method.title}</h2>
      </div>
      <div class="method-copy">
        <p>{copy.method.body}</p>
        <ul>
          <li><a href="https://pubmed.ncbi.nlm.nih.gov/39207406/">{copy.method.consensus} <ExternalLinkIcon /></a></li>
          <li><a href="https://www.healthdirect.gov.au/lymphoedema">{copy.method.healthdirect} <ExternalLinkIcon /></a></li>
          <li><a href="https://github.com/seeliang/lymphoedema-research/blob/main/EDITORIAL_POLICY.md">{copy.method.policy} <ExternalLinkIcon /></a></li>
          <li><a href="https://github.com/seeliang/lymphoedema-research/issues/new">{copy.method.contribute} <ExternalLinkIcon /></a></li>
        </ul>
        <p class="method-note">{copy.method.note}</p>
      </div>
    </div>
  </section>

  <section class="section version-notes" aria-labelledby="changes-title">
    <div class="shell version-notes-inner">
      <div>
        <p class="eyebrow">{copy.changes.eyebrow(data.version)}</p>
        <h2 id="changes-title">{copy.changes.title}</h2>
      </div>
      <ul>
        {data.changes.map((change) => <li>{change}</li>)}
      </ul>
      <a class="text-link" href={withBase(versionsPath)}>{copy.changes.versions}</a>
    </div>
  </section>
</main>

<footer>
  <div class="shell footer-grid">
    <div>
      <a class="brand brand--footer" href={withBase(latestPath)}>
        <BrandMark />
        <span><strong>{copy.siteName}</strong><small>{copy.footer.studio}</small></span>
      </a>
    </div>
    <div class="footer-links">
      <a href="https://github.com/seeliang/lymphoedema-research">{copy.footer.source}</a>
      <a href="https://github.com/seeliang/lymphoedema-research/blob/main/CONTENT_LICENSE.md">{copy.footer.licence}</a>
      <a href="https://github.com/seeliang/lymphoedema-research/blob/main/CORRECTIONS.md">{copy.footer.corrections}</a>
    </div>
    <p>{copy.footer.disclaimer}</p>
  </div>
</footer>
