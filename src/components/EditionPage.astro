---
import type { LocalizedEditionBundle } from "../lib/i18n"
import EvidenceFirstPage from "./EvidenceFirstPage.astro"
import LegacyEditionPage from "./LegacyEditionPage.astro"

interface Props extends LocalizedEditionBundle {
  archive?: boolean
}

const props = Astro.props
const isEvidenceFirst = Boolean(props.edition.data.evidenceOverview)
---

{isEvidenceFirst ? <EvidenceFirstPage {...props} /> : <LegacyEditionPage {...props} />}
