---
import { enAUUI, zhCNUI } from "../i18n/ui"
import { partitionEvidenceSections } from "../lib/evidence-sections"
import { hasZhCNTranslation, type LocalizedEditionBundle } from "../lib/i18n"
import { withBase } from "../lib/paths"
import BrandMark from "./BrandMark.astro"
import EvidenceCard from "./EvidenceCard.astro"
import ExternalLinkIcon from "./ExternalLinkIcon.astro"
import TrialCard from "./TrialCard.astro"

interface Props extends LocalizedEditionBundle {
  archive?: boolean
}

const { edition, evidence, notices, locale, translation, archive = false } = Astro.props
const { data } = edition
if (!data.evidenceOverview || !data.sectionContexts || !data.clinicalReview) {
  throw new Error(`Evidence-first edition ${data.version} is missing its required presentation data`)
}
const isChinese = locale === "zh-CN"
const copy = isChinese ? zhCNUI : enAUUI
const evidenceFirst = copy.evidenceFirst
const childrenSection = data.childrenSection
const deferredCandidates = data.deferredCandidates ?? []
const partitioned = partitionEvidenceSections(evidence)
const treatmentTrials = data.trials.filter((trial) => trial.section === "treatment-management")
const medicineTrials = data.trials.filter((trial) => trial.section === "medicines")
const formatDate = (date: string) => new Intl.DateTimeFormat(locale, {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${date}T00:00:00Z`))
const pagePath = archive ? `/versions/${data.version}/` : "/"
const localePrefix = isChinese ? "/zh-cn" : ""
const languageSwitchPath = isChinese ? pagePath : `/zh-cn${pagePath}`
const latestPath = isChinese ? "/zh-cn/" : "/"
const versionsPath = isChinese ? "/zh-cn/versions/" : "/versions/"
const translationAvailable = hasZhCNTranslation(data.version)
const sectionHref = (id: string) => archive
  ? withBase(`${localePrefix}/versions/${data.version}/#${id}`)
  : `#${id}`
const clinicalApproved = data.clinicalReview.status === "approved"
const languageReviewApproved = translation?.languageReview?.status === "approved"
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBase(latestPath)} aria-label={`${copy.siteName} ${copy.navigation.latest}`}>
      <BrandMark />
      <span><strong>{copy.siteName}</strong><small>{copy.tagline}</small></span>
    </a>
    <div class="header-actions">
      <nav aria-label={copy.navigation.label}>
        <a href={sectionHref("what-works")}>{evidenceFirst.navigation.whatWorks}</a>
        <a href={sectionHref("treatment")}>{evidenceFirst.navigation.treatment}</a>
        <a href={sectionHref("medicines")}>{evidenceFirst.navigation.medicines}</a>
        <a href={sectionHref("children")}>{evidenceFirst.navigation.children}</a>
        <a href={sectionHref("understanding-diagnosis")}>{evidenceFirst.navigation.diagnosis}</a>
        <a href={withBase(versionsPath)}>{evidenceFirst.navigation.versions}</a>
      </nav>
      {(isChinese || translationAvailable) && (
        <a class="language-switch" href={withBase(languageSwitchPath)} lang={isChinese ? "en-AU" : "zh-CN"} hreflang={isChinese ? "en-AU" : "zh-CN"} aria-label={copy.languageSwitch.label}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h10M9 3v2c0 4-2 7-5 9m3-5c1.5 2.5 3.5 4.4 6 5.6M15 10l4 11m2 0-4-11m-.8 7h3.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          {copy.languageSwitch.text}
        </a>
      )}
    </div>
  </div>
</header>

{data.status === "draft" && (
  <aside class="draft-banner" aria-label={evidenceFirst.draft.title}>
    <div class="shell draft-banner-inner">
      <strong>{evidenceFirst.draft.title}</strong>
      <span>{evidenceFirst.draft.body}</span>
    </div>
  </aside>
)}

{archive && data.status !== "draft" && (
  <aside class:list={["archive-banner", data.status !== "current" && "archive-banner--superseded"]} aria-label={copy.archive.label}>
    <div class="shell archive-banner-inner">
      <strong>{data.status === "current" ? copy.archive.currentTitle : copy.archive.supersededTitle}</strong>
      <span>{data.status === "current" ? copy.archive.currentBody(data.version) : copy.archive.supersededBody(data.version)}</span>
      <a href={withBase(latestPath)}>{copy.archive.latestLink}</a>
    </div>
  </aside>
)}

{notices.map((notice) => (
  <aside class="notice-banner" aria-label={copy.notice.label(notice.data.type)}>
    <div class="shell">
      <strong>{copy.notice.title(notice.data.type)}</strong>
      <p>{notice.data.message}</p>
      {notice.data.replacementVersion && <a href={withBase(`${localePrefix}/versions/${notice.data.replacementVersion}/`)}>{copy.notice.replacement(notice.data.replacementVersion)}</a>}
    </div>
  </aside>
))}

<main id="main-content">
  <section class="hero hero--evidence-first">
    <div class="hero-pattern" aria-hidden="true">
      <svg viewBox="0 0 800 420" preserveAspectRatio="xMidYMid slice">
        <g fill="none" stroke="currentColor" stroke-width="2"><path d="M-40 330C120 310 135 120 310 158s210 216 520 50"></path><path d="M80 20c40 110 160 75 205 180s180 85 240 210"></path></g>
        <g fill="currentColor"><circle cx="140" cy="282" r="8"></circle><circle cx="310" cy="158" r="10"></circle><circle cx="515" cy="280" r="7"></circle><circle cx="690" cy="238" r="11"></circle></g>
      </svg>
    </div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{evidenceFirst.heroEyebrow(data.version, formatDate(data.reviewedOn))}</p>
        <h1>{data.title}</h1>
        <p class="lede">{data.summary}</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#what-works">{evidenceFirst.heroButton}</a>
          <a class="button button--secondary" href={withBase(`${localePrefix}/versions/${data.version}/`)}>{copy.hero.permanentLink}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="review-strip" aria-labelledby="review-strip-title">
    <div class="shell review-strip-inner">
      <div class="review-strip-heading">
        <span class:list={["status-dot", !clinicalApproved && "status-dot--unreviewed"]} aria-hidden="true"></span>
        <div><h2 id="review-strip-title">{copy.review.title}</h2><strong>{clinicalApproved ? evidenceFirst.review.approved : evidenceFirst.review.notReviewed}</strong></div>
      </div>
      <dl class="review-strip-facts">
        <div><dt>{evidenceFirst.review.sourceChecked}</dt><dd>{formatDate(data.reviewedOn)}</dd></div>
        <div><dt>{copy.review.nextDue}</dt><dd>{formatDate(data.nextReviewDue)}</dd></div>
        <div><dt>{copy.review.itemCount}</dt><dd>{evidence.length}</dd></div>
        {translation && <div><dt>{evidenceFirst.review.language}</dt><dd>{languageReviewApproved ? evidenceFirst.review.languageApproved : evidenceFirst.review.languageNotReviewed}</dd></div>}
      </dl>
      <details class="review-strip-details">
        <summary>{evidenceFirst.review.details}</summary>
        <dl>
          <div><dt>{evidenceFirst.review.scope}</dt><dd>{data.clinicalReview.scope}</dd></div>
          {clinicalApproved && <div><dt>{evidenceFirst.review.clinical}</dt><dd>{data.clinicalReview.reviewerName}, {data.clinicalReview.credentials} · {formatDate(data.clinicalReview.reviewedOn!)}</dd></div>}
          {translation && <div><dt>{evidenceFirst.review.language}</dt><dd>{languageReviewApproved ? `${translation.languageReview?.reviewerName}, ${translation.languageReview?.reviewerRole} · ${formatDate(translation.languageReview!.reviewedOn!)}` : evidenceFirst.review.languageNotReviewed}</dd></div>}
        </dl>
      </details>
    </div>
  </section>

  <section class="disclaimer" aria-labelledby="disclaimer-title">
    <div class="shell disclaimer-inner">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2.5 20h19L12 3Zm0 6v5m0 3h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <div>
        <h2 id="disclaimer-title">{copy.disclaimer.title}</h2>
        <p>{copy.disclaimer.body}</p>
        <aside class="responsibility-note" aria-labelledby="responsibility-title">
          <h3 id="responsibility-title">{copy.disclaimer.responsibilityTitle}</h3>
          <p>{copy.disclaimer.responsibilityBody}</p>
        </aside>
      </div>
    </div>
  </section>

  {copy.translationNotice && (
    <section class="translation-notice" aria-labelledby="translation-note-title">
      <div class="shell translation-notice-inner">
        <div><h2 id="translation-note-title">{copy.translationNotice.title}</h2><p>{copy.translationNotice.body}</p></div>
        <a class="button button--secondary" href={withBase(pagePath)} hreflang="en-AU">{copy.translationNotice.link}</a>
      </div>
    </section>
  )}

  <section id="what-works" class="section section--overview" aria-labelledby="what-works-title">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">{evidenceFirst.overview.eyebrow}</p><h2 id="what-works-title">{evidenceFirst.overview.title}</h2></div>
        <p>{evidenceFirst.overview.intro}</p>
      </div>
      <div class="overview-list">
        {data.evidenceOverview.items.map((item, index) => (
          <article class="overview-card">
            <div class="overview-status"><span>{String(index + 1).padStart(2, "0")}</span><strong class:list={["evidence-status", `evidence-status--${item.status}`]}>{evidenceFirst.overview.status[item.status]}</strong></div>
            <div class="overview-copy"><h3>{item.title}</h3><p>{item.summary}</p></div>
            <div class="overview-sources"><strong>{evidenceFirst.overview.references}</strong><ul>{item.sources.map((source) => <li><a href={source.url}>{source.label} <ExternalLinkIcon /></a></li>)}</ul></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="treatment" class="section research-section section--tint" aria-labelledby="treatment-title">
    <div class="shell">
      <div class="research-section-heading"><p class="eyebrow">{evidenceFirst.sections.eyebrow}</p><h2 id="treatment-title">{evidenceFirst.sections.treatment.title}</h2><p>{data.sectionContexts.treatmentManagement.intro}</p></div>
      <div class="context-sources"><strong>{evidenceFirst.sections.contextSources}</strong><ul>{data.sectionContexts.treatmentManagement.sources.map((source) => <li><a href={source.url}>{source.label} <ExternalLinkIcon /></a></li>)}</ul></div>
      <h3 class="subsection-title">{evidenceFirst.sections.treatment.evidenceTitle}</h3>
      <div class="evidence-list">{partitioned.treatmentManagement.map((entry, index) => <EvidenceCard entry={entry} locale={locale} number={index + 1} />)}</div>
      {treatmentTrials.length > 0 && <div class="section-trials"><h3 class="subsection-title">{evidenceFirst.sections.treatment.trialTitle}</h3><div class="trial-grid">{treatmentTrials.map((trial) => <TrialCard trial={trial} locale={locale} />)}</div></div>}
    </div>
  </section>

  <section id="medicines" class="section research-section" aria-labelledby="medicines-title">
    <div class="shell">
      <div class="research-section-heading"><p class="eyebrow">{evidenceFirst.sections.eyebrow}</p><h2 id="medicines-title">{evidenceFirst.sections.medicines.title}</h2><p>{data.sectionContexts.medicines.intro}</p></div>
      <div class="context-sources"><strong>{evidenceFirst.sections.contextSources}</strong><ul>{data.sectionContexts.medicines.sources.map((source) => <li><a href={source.url}>{source.label} <ExternalLinkIcon /></a></li>)}</ul></div>
      <h3 class="subsection-title">{evidenceFirst.sections.medicines.evidenceTitle}</h3>
      {partitioned.medicines.length > 0 ? <div class="evidence-list">{partitioned.medicines.map((entry, index) => <EvidenceCard entry={entry} locale={locale} number={index + 1} />)}</div> : <p class="research-empty">{evidenceFirst.sections.medicines.empty}</p>}
      {medicineTrials.length > 0 && <div class="section-trials"><h3 class="subsection-title">{evidenceFirst.sections.medicines.trialTitle}</h3><div class="trial-grid">{medicineTrials.map((trial) => <TrialCard trial={trial} locale={locale} />)}</div></div>}
    </div>
  </section>

  <section id="children" class="section research-section section--tint" aria-labelledby="children-title">
    <div class="shell">
      <div class="research-section-heading"><p class="eyebrow">{evidenceFirst.sections.eyebrow}</p><h2 id="children-title">{evidenceFirst.sections.children.title}</h2><p>{evidenceFirst.sections.children.intro}</p></div>
      {partitioned.children.length > 0 ? <div class="evidence-list">{partitioned.children.map((entry, index) => <EvidenceCard entry={entry} locale={locale} number={index + 1} />)}</div> : childrenSection && (
        <div class="children-empty">
          <h3>{copy.childrenSection.emptyTitle}</h3><p>{childrenSection.summary}</p><p class="children-empty-caution">{copy.childrenSection.caution}</p>
          <dl class="children-section-counts"><div><dt>{copy.childrenSection.publicationCandidates(childrenSection.publicationCandidates)}</dt><dd>{childrenSection.publicationCandidates}</dd></div><div><dt>{copy.childrenSection.trialRecords(childrenSection.trialRecords)}</dt><dd>{childrenSection.trialRecords}</dd></div></dl>
          <a class="text-link" href={childrenSection.reviewUrl}>{copy.childrenSection.reviewLink} <ExternalLinkIcon /></a>
        </div>
      )}
    </div>
  </section>

  <section id="understanding-diagnosis" class="section research-section" aria-labelledby="diagnosis-title">
    <div class="shell">
      <div class="research-section-heading"><p class="eyebrow">{evidenceFirst.sections.eyebrow}</p><h2 id="diagnosis-title">{evidenceFirst.sections.diagnosis.title}</h2><p>{evidenceFirst.sections.diagnosis.intro}</p></div>
      <div class="evidence-list">{partitioned.understandingDiagnosis.map((entry, index) => <EvidenceCard entry={entry} locale={locale} number={index + 1} />)}</div>
    </div>
  </section>

  {partitioned.otherResearch.length > 0 && <section id="other-research" class="section research-section section--tint" aria-labelledby="other-title"><div class="shell"><div class="research-section-heading"><p class="eyebrow">{evidenceFirst.sections.eyebrow}</p><h2 id="other-title">{evidenceFirst.sections.other.title}</h2><p>{evidenceFirst.sections.other.intro}</p></div><div class="evidence-list">{partitioned.otherResearch.map((entry, index) => <EvidenceCard entry={entry} locale={locale} number={index + 1} />)}</div></div></section>}

  {deferredCandidates.length > 0 && (
    <section id="deferred" class="section section--deferred" aria-labelledby="deferred-title"><div class="shell"><div class="section-heading"><div><p class="eyebrow">{copy.deferred.eyebrow}</p><h2 id="deferred-title">{copy.deferred.title}</h2></div><p>{copy.deferred.intro}</p></div><div class="deferred-list">{deferredCandidates.map((candidate) => <article class="deferred-card"><p class="deferred-id">{candidate.id}</p><h3>{candidate.title}</h3><dl><div><dt>{copy.deferred.reason}</dt><dd>{candidate.reason}</dd></div><div><dt>{copy.deferred.revisit}</dt><dd>{candidate.revisitWhen}</dd></div></dl><a class="text-link" href={candidate.url}>{copy.deferred.source} <ExternalLinkIcon /></a></article>)}</div></div></section>
  )}

  <section class="section" aria-labelledby="guide-title"><div class="shell guide-grid"><div><p class="eyebrow">{copy.guide.eyebrow}</p><h2 id="guide-title">{copy.guide.title}</h2><p class="section-intro">{copy.guide.intro}</p></div><dl class="evidence-guide">{copy.guide.items.map(([term, description]) => <div><dt>{term}</dt><dd>{description}</dd></div>)}</dl></div></section>

  <section class="section section--care" aria-labelledby="care-title"><div class="shell care-grid"><div><p class="eyebrow">{copy.care.eyebrow}</p><h2 id="care-title">{copy.care.title}</h2><p>{copy.care.body}</p><div class="resource-links"><a class="button button--light" href="https://www.healthdirect.gov.au/lymphoedema">{copy.care.healthdirect} <ExternalLinkIcon /></a><a class="button button--outline-light" href="https://www.lymphoedema.org.au/accreditation-nlpr/find-a-practitioner/">{copy.care.practitioner} <ExternalLinkIcon /></a></div></div><aside class="urgent-card"><h3>{copy.care.urgentTitle}</h3><p>{copy.care.urgentBody}</p><a href="https://www.healthdirect.gov.au/lymphoedema">{copy.care.urgentLink} <ExternalLinkIcon /></a></aside></div></section>

  <section class="section section--method" aria-labelledby="method-title"><div class="shell method-grid"><div><p class="eyebrow">{copy.method.eyebrow}</p><h2 id="method-title">{copy.method.title}</h2></div><div class="method-copy"><p>{copy.method.body}</p><ul><li><a href="https://pubmed.ncbi.nlm.nih.gov/39207406/">{copy.method.consensus} <ExternalLinkIcon /></a></li><li><a href="https://www.healthdirect.gov.au/lymphoedema">{copy.method.healthdirect} <ExternalLinkIcon /></a></li><li><a href="https://github.com/seeliang/lymphoedema-research/blob/main/EDITORIAL_POLICY.md">{copy.method.policy} <ExternalLinkIcon /></a></li><li><a href="https://github.com/seeliang/lymphoedema-research/issues/new">{copy.method.contribute} <ExternalLinkIcon /></a></li></ul><p class="method-note">{copy.method.note}</p></div></div></section>

  <section class="section version-notes" aria-labelledby="changes-title"><div class="shell version-notes-inner"><div><p class="eyebrow">{copy.changes.eyebrow(data.version)}</p><h2 id="changes-title">{copy.changes.title}</h2></div><ul>{data.changes.map((change) => <li>{change}</li>)}</ul><a class="text-link" href={withBase(versionsPath)}>{copy.changes.versions}</a></div></section>
</main>

<footer><div class="shell footer-grid"><div><a class="brand brand--footer" href={withBase(latestPath)}><BrandMark /><span><strong>{copy.siteName}</strong><small>{copy.footer.studio}</small></span></a></div><div class="footer-links"><a href="https://github.com/seeliang/lymphoedema-research">{copy.footer.source}</a><a href="https://github.com/seeliang/lymphoedema-research/blob/main/CONTENT_LICENSE.md">{copy.footer.licence}</a><a href="https://github.com/seeliang/lymphoedema-research/blob/main/CORRECTIONS.md">{copy.footer.corrections}</a></div><p>{clinicalApproved ? (isChinese && languageReviewApproved ? evidenceFirst.footer.clinicallyAndLanguageReviewed : evidenceFirst.footer.clinicallyReviewed) : copy.footer.disclaimer}</p></div></footer>
